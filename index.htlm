<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Chat Saya Sekarang</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #ffffff;
            font-family: Arial, Helvetica, sans-serif;
        }

        .chat-button {
            display: inline-block;
            padding: 35px 55px;
            background: linear-gradient(135deg, #0866ff, #0052d4);
            color: white;
            font-size: clamp(24px, 5vw, 60px);
            font-weight: 900;
            text-align: center;
            text-decoration: none;
            border-radius: 35px;
            box-shadow: 0 15px 35px rgba(0, 82, 212, 0.25);
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .chat-button:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 82, 212, 0.35);
        }

        @media (max-width: 480px) {
            .chat-button {
                padding: 25px 20px;
                border-radius: 22px;
                margin: 15px;
            }
        }
    </style>
</head>

<body>
    <a class="chat-button" href="#" onclick="return false;">
        CHAT SAYA SEKARANG
    </a>
</body>
</html>